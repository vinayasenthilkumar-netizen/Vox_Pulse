<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Page title includes Organiser page and the site name -->
  <title>Organiser Home • <%= name %></title>
  <!-- Main CSS file (includes Bootstrap and any project-specific styles) -->
  <link rel="stylesheet" href="/main.css">
</head>
<body class="organiser-page bg-light text-dark">

<!-- =======================
The Top Navigation 
Provides links for organiser realted actions
======================= -->
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
      <!-- Label -->
      <a class="navbar-brand" href="/">Organiser Portal</a>
      
      <!-- Collapsible menu items -->
      <div class="collapse navbar-collapse" id="orgNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link" href="/organiser/logout">Logout</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/organiser/events/new">Create event</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/organiser/settings">Site Settings</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/organiser/events/view-bookings">View Bookings</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main content area -->
  <div class="container py-5">

<!-- =======================
Header Section
Displays the site title and description
======================= -->
    <header class="text-start mb-5 org-header">
      <h1 class="display-5"><%= name %></h1>
      <% if (description) { %>
        <p class="h5 text-dark"><%= description %></p>
      <% } %>
    </header>

<!-- =======================
Event Count Summary 
Quick overview of total, published, and draft events
======================= -->
    <div class="row text-center mb-5 summary-row">
      <!-- Total events count -->
      <div class="col-md-4">
        <div class="card text-white bg-info mb-3 p-3">
          <div class="card-body">
            <h6 class="card-subtitle mb-2">Total Events</h6>
            <p class="display-5 fw-bold mb-0">
              <%= published.length + drafts.length %>
            </p>
          </div>
        </div>
      </div>
      <!-- Published events count -->
      <div class="col-md-4">
        <div class="card text-white bg-success mb-3 p-3">
          <div class="card-body">
            <h6 class="card-subtitle mb-2">Published</h6>
            <p class="display-5 fw-bold mb-0"><%= published.length %></p>
          </div>
        </div>
      </div>
      <!-- Draft events count -->
      <div class="col-md-4">
        <div class="card text-white bg-warning mb-3 p-3">
          <div class="card-body">
            <h6 class="card-subtitle mb-2">Drafts</h6>
            <p class="display-5 fw-bold mb-0"><%= drafts.length %></p>
          </div>
        </div>
      </div>
    </div>

<!-- =======================
Published Events Accordian ( drop down )
Lists each published event with details and action buttons
======================= -->

    <div class="accordion mb-5" id="publishedAccordion">
      <h3 class="mb-3">Published Events</h3>
      <% if (published.length) { %>
        <% published.forEach((evt, idx) => { %>
          <div class="accordion-item">
            <!-- Header button shows title, date, and Sold Out badge if needed -->
            <h2 class="accordion-header" id="pubHeading<%= idx %>">
              <button class="accordion-button collapsed" type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#pubCollapse<%= idx %>"
                      aria-expanded="false"
                      aria-controls="pubCollapse<%= idx %>">
                <%= evt.title %>
                <% if (evt.child_price_quantity === 0 || evt.adult_quantity === 0) { %>
                  <span class="badge bg-danger ms-2">Sold Out</span>
                <% } %>
                <small class="text-muted ms-3">
                  <%= new Date(evt.event_date).toLocaleDateString() %>
                </small>
              </button>
            </h2>
            <!-- Collapsible body with full event info and controls -->
            <div id="pubCollapse<%= idx %>" class="accordion-collapse collapse"
                 aria-labelledby="pubHeading<%= idx %>"
                 data-bs-parent="#publishedAccordion">
              <div class="accordion-body">
                <p><strong>Ends:</strong>
                  <%= new Date(evt.event_end).toLocaleDateString() %>
                </p>
                <p><%= evt.description %></p>
                <p><strong>Tickets:</strong>
                  Child (<%= evt.child_price_quantity %> @ $<%= evt.child_price_price %>),
                  Adult (<%= evt.adult_quantity %> @ $<%= evt.adult_price %>)
                </p>
                <div class="btn-group">
                  <!-- <a href="/organiser/events/<%= evt.id %>/edit"
                     class="btn btn-outline-primary">Edit</a> -->
                  <form action="/organiser/events/<%= evt.id %>/delete" method="POST">
                    <button type="submit" class="btn btn-outline-danger">
                      Delete
                    </button>
                  </form>
                  <a href="/attendee" class="btn btn-outline-success">
                    Attendee View
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <!-- Message when no published events exist -->
        <p class="text-center fst-italic">No published events yet.</p>
      <% } %>
    </div>

<!-- =======================
Draft Events Accordian ( drop down)
Similar to published events but with the publish action
======================= -->

    <div class="accordion" id="draftAccordion">
      <h3 class="mb-3">Draft Events</h3>
      <% if (drafts.length) { %>
        <% drafts.forEach((evt, idx) => { %>
          <div class="accordion-item">
            <h2 class="accordion-header" id="draftHeading<%= idx %>">
              <button class="accordion-button collapsed" type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#draftCollapse<%= idx %>"
                      aria-expanded="false"
                      aria-controls="draftCollapse<%= idx %>">
                <%= evt.title %>
                — <small class="text-muted">
                  <%= new Date(evt.event_date).toLocaleDateString() %>
                </small>
              </button>
            </h2>
            <div id="draftCollapse<%= idx %>" class="accordion-collapse collapse"
                 aria-labelledby="draftHeading<%= idx %>"
                 data-bs-parent="#draftAccordion">
              <div class="accordion-body">
                <p><strong>Ends:</strong>
                  <%= new Date(evt.event_end).toLocaleDateString() %>
                </p>
                <p><%= evt.description %></p>
                <p><strong>Tickets:</strong>
                  Child (<%= evt.child_price_quantity %> @ $<%= evt.child_price_price %>),
                  Adult (<%= evt.adult_quantity %> @ $<%= evt.adult_price %>)
                </p>
                <div class="btn-group">
                  <a href="/organiser/events/<%= evt.id %>/edit"
                     class="btn btn-outline-primary">Edit</a>
                  <form action="/organiser/events/<%= evt.id %>/publish" method="POST">
                    <button type="submit" class="btn btn-outline-success">
                      Publish
                    </button>
                  </form>
                  <form action="/organiser/events/<%= evt.id %>/delete" method="POST">
                    <button type="submit" class="btn btn-outline-danger">
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <!-- Message when no drafts are available -->
        <p class="text-center fst-italic">No draft events.</p>
      <% } %>
    </div>

  </div>

  <!-- Bootstrap JS for accordion, navbar toggle, etc. -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
