<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Main stylesheet (includes Bootstrap and any custom styles) -->
  <link rel="stylesheet" href="/main.css" />
  <!-- Page title shown in the browser tab -->
  <title>Create a New Event</title>
</head>
<body class="create-event-page position-relative">

  <!-- Back button in the top-right corner to return to the organiser page -->
  <a href="/organiser" class="btn btn-pink position-absolute top-0 end-0 m-3">
    ← Back
  </a>

  <div class="container">
    <!-- Form header -->
    <h1 class="text-center mb-4">Create a New Event</h1>

    <!-- Event creation form -->
    <form action="/organiser/events/new" method="POST" class="event-form">
      
      <!-- Event title input -->
      <div class="mb-3">
        <label for="title" class="form-label">Event Title</label>
        <input
          id="title"
          name="title"
          type="text"
          class="form-control"
          value="<%= event.title || '' %>"
          required
        />
      </div>

      <!-- Put start and end date side by side -->
      <div class="row g-3">
        <div class="col-md-6">
          <label for="event_date" class="form-label">Start Date</label>
          <input
            id="event_date"
            name="event_date"
            type="date"
            class="form-control"
            value="<%= event.event_date || '' %>"
            required
          />
        </div>
        <div class="col-md-6">
          <label for="event_end" class="form-label">End Date</label>
          <input
            id="event_end"
            name="event_end"
            type="date"
            class="form-control"
            value="<%= event.event_end || '' %>"
            required
          />
        </div>
      </div>

      <!-- Event description textarea -->
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          id="description"
          name="description"
          class="form-control"
          rows="4"
          required
        ><%= event.description || '' %></textarea>
      </div>

      <!-- Child ticket : setting the  quantity and price -->
      <div class="row g-3">
        <div class="col-md-6">
          <label for="child_price_quantity" class="form-label">
            Child Tickets (Qty)
          </label>
          <input
            id="child_price_quantity"
            name="child_price_quantity"
            type="number"
            min="0"
            class="form-control"
            value="<%= event.child_price_quantity || 0 %>"
          />
        </div>
        <div class="col-md-6">
          <label for="child_price_price" class="form-label">
            Child Ticket Price
          </label>
          <input
            id="child_price_price"
            name="child_price_price"
            type="number"
            step="0.01"
            class="form-control"
            value="<%= event.child_price_price || 0 %>"
          />
        </div>
      </div>

      <!-- Adult ticket : setting the quantity and price -->
      <div class="row g-3 mt-3">
        <div class="col-md-6">
          <label for="adult_quantity" class="form-label">
            Adult Tickets (Qty)
          </label>
          <input
            id="adult_quantity"
            name="adult_quantity"
            type="number"
            min="0"
            class="form-control"
            value="<%= event.adult_quantity || 0 %>"
          />
        </div>
        <div class="col-md-6">
          <label for="adult_price" class="form-label">
            Adult Ticket Price
          </label>
          <input
            id="adult_price"
            name="adult_price"
            type="number"
            step="0.01"
            class="form-control"
            value="<%= event.adult_price || 0 %>"
          />
        </div>
      </div>

      <!-- Submit button -->
      <div class="d-grid mt-4">
        <button type="submit" class="btn btn-pink">
          Create Event
        </button>
      </div>
    </form>
  </div>

  <!-- Script to prevent selecting past dates -->
  <script>
    // Get today's date in YYYY-MM-DD format
    const today = new Date().toISOString().split('T')[0];
    // Set the allowed date for start and end inputs ( start from today )
    document.getElementById('event_date').setAttribute('min', today);
    document.getElementById('event_end').setAttribute('min', today);
  </script>

  <!-- Bootstrap JS bundle for any interactive components -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
