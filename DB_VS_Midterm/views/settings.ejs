<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Link to main stylesheet (includes Bootstrap & custom CSS) -->
  <link rel="stylesheet" href="/main.css" />
  <!-- Page title showing settings and site name -->
  <title>Site Settings • <%= name %></title>
</head>
<body class="settings-page">

<!-- ============================
Top Navigation Bar
Simple header indicating current section
============================ -->

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <!-- Static brand text for the settings page -->
      <a class="navbar-brand">Site Settings Page</a>
    </div>
  </nav>

<!-- ============================
Settings Form
Centered card where organisers can update site info
============================ -->

  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="card shadow-lg settings-card">
          <!-- Card header with title -->
          <div class="card-header bg-pink text-white">
            <h4 class="mb-0">Site Settings</h4>
          </div>
          <div class="card-body">
            <!-- Display error message if saving fails -->
            <% if (error) { %>
              <div class="alert alert-danger" role="alert">
                <%= error %>
              </div>
            <% } %>

            <!-- Form for updating site name and the description -->
            <form action="/organiser/settings" method="POST">
              <!-- Input for site name with label -->
              <div class="mb-4 form-floating">
                <input
                  id="name"
                  name="name"
                  type="text"
                  class="form-control"
                  placeholder="Site Name"
                  value="<%= name %>"
                  required
                />
                <label for="name">Site Name</label>
              </div>

              <!-- Text area for site description with label -->
              <div class="mb-4 form-floating">
                <textarea
                  id="description"
                  name="description"
                  class="form-control"
                  placeholder="Site Description"
                  required
                ><%= description %></textarea>
                <label for="description">Site Description</label>
              </div>

              <!-- Submit button aligned to the right -->
              <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-pink px-4">
                  Save Changes
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS bundle for any interactive UI components -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
