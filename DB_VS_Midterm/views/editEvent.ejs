<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <!-- Link to main stylesheet (Bootstrap + custom styles) -->
  <link rel="stylesheet" href="/main.css"/>

  <!-- Dynamic page title showing edit event and the event title -->
  <title>Edit Event • <%= event.title %></title>
</head>
<body class="edit-event-page position-relative">

  <!-- Back button: returns to organiser page -->
  <a href="/organiser" class="btn btn-pink position-absolute top-0 end-0 m-3">
    ← Back
  </a>

  <div class="container">
    <!-- Page header -->
    <h1 class="text-center mb-4">Edit Event</h1>

    <!-- Event editing form -->
    <form action="/organiser/events/<%= event.id %>/edit" method="POST" class="event-form">

      <!-- Event title input with floating label -->
      <div class="mb-3 form-floating">
        <input
          id="title"
          name="title"
          type="text"
          class="form-control"
          placeholder="Event Title"
          value="<%= event.title %>"
          required
        />
        <label for="title">Event Title</label>
      </div>

      <!-- Put the start and end date side by side -->
      <div class="row g-3 mb-3">
        <div class="col-md-6 form-floating">
          <input
            id="event_date"
            name="event_date"
            type="date"
            class="form-control"
            placeholder="Start Date"
            value="<%= event.event_date %>"
            required
          />
          <label for="event_date">Start Date</label>
        </div>
        <div class="col-md-6 form-floating">
          <input
            id="event_end"
            name="event_end"
            type="date"
            class="form-control"
            placeholder="End Date"
            value="<%= event.event_end %>"
            required
          />
          <label for="event_end">End Date</label>
        </div>
      </div>

      <!-- Event description textarea -->
      <div class="mb-3 form-floating">
        <textarea
          id="description"
          name="description"
          class="form-control"
          placeholder="Description"
          required
        ><%= event.description %></textarea>
        <label for="description">Description</label>
      </div>

      <!-- Child ticket quantity and price inputs -->
      <div class="row g-3 mb-3">
        <div class="col-md-6 form-floating">
          <input
            id="child_price_quantity"
            name="child_price_quantity"
            type="number"
            min="0"
            class="form-control"
            placeholder="Child Qty"
            value="<%= event.child_price_quantity %>"
          />
          <label for="child_price_quantity">Child Tickets Qty</label>
        </div>
        <div class="col-md-6 form-floating">
          <input
            id="child_price_price"
            name="child_price_price"
            type="number"
            step="0.01"
            class="form-control"
            placeholder="Child Price"
            value="<%= event.child_price_price %>"
          />
          <label for="child_price_price">Child Ticket Price</label>
        </div>
      </div>

      <!-- Adult ticket quantity and price inputs -->
      <div class="row g-3 mb-4">
        <div class="col-md-6 form-floating">
          <input
            id="adult_quantity"
            name="adult_quantity"
            type="number"
            min="0"
            class="form-control"
            placeholder="Adult Qty"
            value="<%= event.adult_quantity %>"
          />
          <label for="adult_quantity">Adult Tickets Qty</label>
        </div>
        <div class="col-md-6 form-floating">
          <input
            id="adult_price"
            name="adult_price"
            type="number"
            step="0.01"
            class="form-control"
            placeholder="Adult Price"
            value="<%= event.adult_price %>"
          />
          <label for="adult_price">Adult Ticket Price</label>
        </div>
      </div>

      <!-- Submit button to save the changes -->
      <div class="d-grid">
        <button type="submit" class="btn btn-pink">
          Save Changes
        </button>
      </div>

    </form>
  </div>

  <!-- Script to prevent choosing past dates -->
  <script>
    // Format date like this :  YYYY-MM-DD ( also put to todays date )
    const today = new Date().toISOString().split('T')[0];
    // Set minimum date on both date pickers
    document.getElementById('event_date').setAttribute('min', today);
    document.getElementById('event_end').setAttribute('min', today);
  </script>

  <!-- Bootstrap JavaScript for interactive components -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
